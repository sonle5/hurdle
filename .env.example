# Claude Code and the optional Judge. Use either API-key or OAuth auth.
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# Together evaluation tasks and the Together sandbox.
TOGETHER_API_KEY=

# Codex agents. Uncomment one supported credential when selecting Codex.
# CODEX_API_KEY=
# OPENAI_API_KEY=

# DeepSeek Harness (dsh) agents, local runtime only. Optionally point
# HURDLE_DSH_PROVIDERS at a providers JSON file and set each provider's apiKeyEnv.
# DEEPSEEK_API_KEY=
# HURDLE_DSH_PROVIDERS=

# Optional Postgres result storage.
# HURDLE_RESULT_STORE_DATABASE_URL=postgresql://
