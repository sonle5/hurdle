        "kind": "captured-http-header",
        "hosts": [
          "api.together.ai",
          "api.together.xyz"
        ],
        "headerNames": [
          "authorization"
        ]
      }
    }
  },
  "tasks": {
    "chat-app": {
      "prompt": "Build a CLI tool for the controlled E2B contract test.",
      "fixtures": [
        {
          "source": "fixture.txt",
          "workspacePath": "fixtures/input.txt"
        }
      ],
      "outputArtifacts": [
        {
          "path": "outputs/generated-image",
          "kind": "binary",
          "maxBytes": 16777216,
          "required": false
        }
      ],
      "credentialRequirements": [
        "TOGETHER_API_KEY"
      ],
      "executionRequirements": [
        "environment.isolated-workspace"
      ],
      "evaluation": {
        "deterministicEvaluator": "evaluate.mjs"
      }
    }
  },
  "conditions": {
    "baseline": {
      "displayName": "Baseline",
      "description": "No Together skills or documentation MCP.",
      "executionRequirements": [
        "agent.selected-context"
      ],
      "resources": {
        "skills": [],
        "mcpServers": []
      }
    }
  }
}
