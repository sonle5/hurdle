{
  "schemaVersion": 1,
  "target": {
    "id": "together-ai",
    "displayName": "Together AI",
    "description": "Test-only trusted egress, credentials and disposal fixture.",
    "egress": {
      "relevantHosts": [
        "api.together.ai",
        "api.together.xyz"
      ],
      "selectedFields": []
    }
  },
  "credentialRequirements": {
    "TOGETHER_API_KEY": {
      "minimumScopes": [
        "project"
      ],
